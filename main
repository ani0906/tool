  <script>
    // --- Web Audio 音效合成器 (免外部音訊檔) ---
    let audioCtx = null;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
    }

    function playSound(type) {
      if (!audioCtx) return;
      
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      const now = audioCtx.currentTime;

      if (type === 'click') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(400, now);
        osc.frequency.exponentialRampToValueAtTime(100, now + 0.08);
        gain.gain.setValueAtTime(0.3, now);
        gain.gain.linearRampToValueAtTime(0.01, now + 0.08);
        osc.start(now);
        osc.stop(now + 0.08);
      } else if (type === 'unlock') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(523.25, now); // C5
        osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
        osc.frequency.setValueAtTime(783.99, now + 0.2); // G5
        gain.gain.setValueAtTime(0.4, now);
        gain.gain.linearRampToValueAtTime(0.01, now + 0.5);
        osc.start(now);
        osc.stop(now + 0.5);
      } else if (type === 'shatter') {
        // 白雜訊模擬碎裂聲
        const bufferSize = audioCtx.sampleRate * 0.4;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }
        const noise = audioCtx.createBufferSource();
        noise.buffer = buffer;
        const noiseFilter = audioCtx.createBiquadFilter();
        noiseFilter.type = 'highpass';
        noiseFilter.frequency.value = 1000;
        
        noise.connect(noiseFilter);
        noiseFilter.connect(gain);
        gain.gain.setValueAtTime(0.6, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
        noise.start(now);
      } else if (type === 'eerie') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(110, now);
        osc.frequency.exponentialRampToValueAtTime(55, now + 2.0);
        gain.gain.setValueAtTime(0.2, now);
        gain.gain.linearRampToValueAtTime(0.01, now + 2.0);
        osc.start(now);
        osc.stop(now + 2.0);
      }
    }

    // --- 遊戲狀態管理 ---
    const digits = [0, 0, 0];
    const targetCode = [1, 5, 8]; // 正確密碼：158
    let isUnlocked = false;
    let isKeyCollected = false;

    function setDialog(text) {
      document.getElementById('dialogBox').innerText = text;
    }

    function initGame() {
      initAudio();
      playSound('click');
      document.getElementById('startScene').classList.remove('active');
      document.getElementById('grassScene').classList.add('active');
      setDialog("你來到了深夜的草叢荒野。前方聳立著一座詭異的狗雕像，頸部似乎閃爍著微光...");
    }

    function showSignHint() {
      playSound('click');
      setDialog("告示牌上記錄著悲傷的數據：「全台僅存野外配對數量：158 對...」");
    }

    function openLockModal() {
      if (isUnlocked) return;
      playSound('click');
      document.getElementById('lockModal').classList.add('active');
      setDialog("你靠近了狗狗雕像，項圈上鎖著密碼鎖。");
    }

    function closeLockModal() {
      playSound('click');
      document.getElementById('lockModal').classList.remove('active');
    }

    function changeDigit(index, delta) {
      playSound('click');
      digits[index] = (digits[index] + delta + 10) % 10;
      document.getElementById(`digit${index}`).innerText = digits[index];
      checkLockCode();
    }

    function checkLockCode() {
      if (digits[0] === targetCode[0] && digits[1] === targetCode[1] && digits[2] === targetCode[2]) {
        isUnlocked = true;
        playSound('unlock');
        document.getElementById('lockStatusText').innerText = "🔓 喀嗒！密碼正確，項圈鬆開了！";
        document.getElementById('lockStatusText').style.color = "#4ade80";

        setTimeout(() => {
          closeLockModal();
          triggerStatueShatter();
        }, 1200);
      }
    }

    function triggerStatueShatter() {
      playSound('shatter');
      document.getElementById('collarGlow').style.display = 'none';
      document.getElementById('dogStatueFull').style.display = 'none';
      document.getElementById('dogStatueBroken').style.display = 'block';
      document.getElementById('keyItem').style.display = 'block';

      setDialog("💥 隨著密碼解開，狗雕像瞬間粉碎炸裂！碎石堆中露出一把【銹蝕的鑰匙】。");
    }

    function collectKeyAndTransition() {
      if (isKeyCollected) return;
      isKeyCollected = true;
      playSound('click');
      document.getElementById('keyItem').style.display = 'none';
      setDialog("🔑 你拾起了【銹蝕的鑰匙】... 突如其來的一陣暈眩感，引導著你往前走去！");

      // 一幀一幀推近動畫轉場
      const grassScene = document.getElementById('grassScene');
      grassScene.classList.add('zoom-forward');

      setTimeout(() => {
        grassScene.classList.remove('active', 'zoom-forward');
        document.getElementById('mirrorScene').classList.add('active');
        playSound('eerie');
        setDialog("穿過迷霧，眼前出現了一面老舊的鏡子...");
      }, 1500);
    }

    function triggerMirrorReveal() {
      playSound('eerie');
      const owlSvg = document.getElementById('owlSvg');
      owlSvg.classList.add('revealed');

      document.getElementById('storyText').innerHTML = `
        鏡子裡映照出的，不是人類的模樣...<br><br>
        而是一隻帶有心形面具、眼神深邃無奈的<span class="highlight">草鴞</span>。<br>
        全台僅存約 <span class="highlight">158 對</span> 繁衍個體，你正是其中之一。
      `;

      setDialog("真相揭曉：你不是旁觀的探索者，你就是在這片土地上苦苦求生的草鴞。");
      document.getElementById('restartBtn').style.display = 'inline-block';
    }
  </script>
</body>
</html>
